<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!--
      Native alarm scheduling. SCHEDULE_EXACT_ALARM is a normal permission
      on API 31+ but the user can revoke it from Settings; we ask at runtime
      in a later phase. USE_EXACT_ALARM is the auto-granted alternative but
      is gated by Play Store policy to alarm/calendar apps, so we stick
      with SCHEDULE_EXACT_ALARM for the general-purpose path.
    -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />

    <!--
      Required to post notifications on Android 13+ (API 33+), including the
      foreground service notification. This is a runtime permission; without
      it the ringing service cannot run in the foreground and stops itself.
    -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
      Phase 1.2 foreground ringing service. FOREGROUND_SERVICE is required to
      call startForeground(); FOREGROUND_SERVICE_MEDIA_PLAYBACK matches the
      service's android:foregroundServiceType="mediaPlayback" declaration
      (required on Android 14+); VIBRATE drives the alarm vibration pattern;
      WAKE_LOCK keeps the CPU awake via a partial wake lock while ringing.
      All four are install-time (normal) permissions, no runtime prompt.
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <application
        android:label="alarmx"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>

        <!--
          Receives the broadcast fired by AlarmManager when a scheduled
          alarm goes off. Not exported because it must only be triggerable
          by our own PendingIntents.
        -->
        <receiver
            android:name=".AlarmReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.alarmx.app.alarmx.ALARM_FIRE" />
            </intent-filter>
        </receiver>

        <!--
          Phase 1.2 ringing service started by AlarmReceiver. Not exported: only
          our own process starts/stops it. The mediaPlayback foreground type
          covers continuous alarm audio; the matching FOREGROUND_SERVICE and
          FOREGROUND_SERVICE_MEDIA_PLAYBACK permissions are declared above.
        -->
        <service
            android:name=".AlarmForegroundService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
